{
  "title": "Alerts Overview",
  "panels": [
    {
      "title": "Active Alerts",
      "type": "table",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "instance": "Instance"
            }
          }
        }
      ]
    }
  ]
} 